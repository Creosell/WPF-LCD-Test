<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Dark theme: the application brushes (surfaces, text, lines, statuses). Both theme files define the same keys; the active one is swapped at runtime.  -->
    <SolidColorBrush x:Key="AppPageBackground" Color="#FF424242" />
    <SolidColorBrush x:Key="AppPanelBackground" Color="#FF2A2828" />
    <SolidColorBrush x:Key="AppInsetBackground" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="AppPanelBorder" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="AppCardBackground" Color="#26000000" />
    <SolidColorBrush x:Key="AppCardBorder" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="AppTextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppTextLabel" Color="#E5FFFFFF" />
    <SolidColorBrush x:Key="AppTextSecondary" Color="#B5FFFFFF" />
    <SolidColorBrush x:Key="AppTextMuted" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="AppLogText" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="AppTabLine" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="AppControlBorder" Color="#FFAAAAAA" />
    <SolidColorBrush x:Key="AppHoverOverlay" Color="#22000000" />
    <SolidColorBrush x:Key="StatusOkText" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="StatusWarnText" Color="#FFFFC107" />
    <SolidColorBrush x:Key="StatusErrText" Color="#FFFF5252" />
    <SolidColorBrush x:Key="StatusOkDot" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="StatusWarnDot" Color="#FFFFC107" />
    <SolidColorBrush x:Key="StatusErrDot" Color="#FFFF5252" />
    <SolidColorBrush x:Key="StatusOkPlate" Color="#334CAF50" />
    <SolidColorBrush x:Key="StatusWarnPlate" Color="#33FFC107" />
    <SolidColorBrush x:Key="StatusErrPlate" Color="#33FF5252" />
    <SolidColorBrush x:Key="ResultOkDot" Color="#FF4CD964" />
    <SolidColorBrush x:Key="ResultWarnDot" Color="#FFFFB020" />
    <SolidColorBrush x:Key="LogWarnBackground" Color="Transparent" />
    <SolidColorBrush x:Key="LogErrBackground" Color="Transparent" />
    <SolidColorBrush x:Key="LogWarnBar" Color="Transparent" />
    <SolidColorBrush x:Key="LogErrBar" Color="Transparent" />
    <Thickness x:Key="LogBarThickness">0,0,0,0</Thickness>
</ResourceDictionary>
