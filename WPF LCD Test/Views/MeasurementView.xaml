<UserControl
    x:Class="WPF_LCD_Test.Views.MeasurementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPF_LCD_Test.Models"
    xmlns:services="clr-namespace:WPF_LCD_Test.Services"
    xmlns:viewmodels="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MeasurementViewModel}"
    Background="#FF424242"
    Focusable="True"
    FontSize="15"
    Foreground="White"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    PreviewMouseDown="UserControl_PreviewMouseDown"
    mc:Ignorable="d">
    <!--
        d:DesignHeight="600"
        d:DesignWidth="800"
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  HierarchicalDataTemplate driving the cascading device configuration menu; propagates recursively to nested folder submenus.  -->
        <HierarchicalDataTemplate DataType="{x:Type models:DeviceConfigTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}" />
        </HierarchicalDataTemplate>

        <!--
            Compact MenuItem template: MaterialDesign's default MenuItem chrome reserves a wide fixed-width
            icon gutter on the left even when no Icon is set, which reads as an oversized indent for a plain
            text list. This template renders only a checkmark column (collapsed to zero width unless
            checked), the header text, and a submenu arrow (only when the item has children).
        -->
        <ControlTemplate x:Key="DeviceConfigMenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bg" Background="Transparent" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CheckGlyph"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="✓"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header" />
                    <Path
                        x:Name="SubmenuArrow"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Data="M0,0 L4,4 L0,8"
                        Fill="{TemplateBinding Foreground}"
                        Visibility="Collapsed" />
                    <Popup
                        x:Name="PART_Popup"
                        AllowsTransparency="False"
                        Focusable="False"
                        HorizontalOffset="10"
                        IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                        Placement="Right"
                        PopupAnimation="None"
                        VerticalOffset="-6">
                        <Border
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="#FFAAAAAA"
                            BorderThickness="1">
                            <ItemsPresenter />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
            MaterialDesign assigns ContextMenu/MenuItem its own default ItemContainerStyle, which takes
            precedence over any implicit (unkeyed) TargetType="MenuItem" style for generated containers.
            This style must therefore be applied explicitly via ItemContainerStyle, and re-applies itself
            to its own ItemContainerStyle so it keeps propagating into nested folder submenus.

            Selection itself stays on Command/CommandParameter (bound to the ViewModel's
            SelectDeviceConfigurationCommand), keeping the MVVM action in the ViewModel. The Click
            EventSetter is only a bridge invoking that already-bound Command: containers generated
            inside a ContextMenu's nested Popups do not reliably raise ICommandSource execution on
            their own in this MaterialDesign setup, so the bridge forces it explicitly.
        -->
        <Style x:Key="DeviceConfigMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template" Value="{StaticResource DeviceConfigMenuItemTemplate}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DeviceConfigMenuItemStyle}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="CommandParameter" Value="{Binding RelativePath}" />
            <EventSetter Event="Click" Handler="DeviceConfigMenuItem_Click" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter Property="IsCheckable" Value="True" />
                    <Setter Property="IsChecked" Value="{Binding IsSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            MaterialDesignFlatButton fills the entire button area on hover (a ripple-style highlight),
            which reads as inconsistent next to the plain underline hover of the SN TextBox. This template
            keeps only a bottom underline that brightens on hover, matching the TextBox's affordance.
        -->
        <Style x:Key="DeviceConfigDropdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Underline" BorderBrush="Black" BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="0,0,0,4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="MeasurementButtonsStyle"
            BasedOn="{StaticResource MaterialDesignFlatDarkBgButton}"
            TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="MaterialDesign:ButtonAssist.CornerRadius" Value="15" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="50*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*" />
                <ColumnDefinition Width="55*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button
                        Margin="5"
                        MaterialDesign:ButtonAssist.CornerRadius="15"
                        Command="{Binding DataContext.ZeroCalibrationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Content="{DynamicResource ZeroCalibration}" />
                    <StackPanel
                        Margin="20,0,10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding DeviceConnectionStatusText}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding DeviceCalibrationStatusText}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource DeviceConfiguration}"
                            Foreground="White" />
                        <Button
                            x:Name="DeviceConfigurationButton"
                            MinWidth="200"
                            MinHeight="20"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="DeviceConfigurationButton_Click"
                            Foreground="White"
                            Style="{StaticResource DeviceConfigDropdownButtonStyle}"
                            Tag="{Binding}">
                            <Button.ContextMenu>
                                <ContextMenu
                                    DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                    ItemContainerStyle="{StaticResource DeviceConfigMenuItemStyle}"
                                    ItemsSource="{Binding DeviceConfigurationTree}"
                                    Placement="Bottom" />
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    Text="{Binding SelectedDeviceConfigurationDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedDeviceConfiguration}" Value="False">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <MaterialDesign:PackIcon
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="ChevronDown" />
                            </StackPanel>
                        </Button>



                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource SerialNumber}"
                            Foreground="#E5FFFFFF" />
                        <TextBox
                            x:Name="SerialNumberTextBox"
                            MinWidth="200"
                            Margin="5"
                            VerticalAlignment="Center"
                            Foreground="White"
                            LostFocus="SerialNumberTextBox_LostFocus"
                            Text="{Binding SerialNumber, UpdateSourceTrigger=Explicit}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding DataContext.ApplySerialNumberCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Text, ElementName=SerialNumberTextBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label Content="{DynamicResource TV}" Foreground="White" />
                        <CheckBox Margin="5" IsChecked="{Binding IsTvCheckboxChecked}" />
                    </StackPanel>
                </Grid>
            </Grid>


            <Grid Grid.Column="1" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[TopLeft].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.TopLeft}"
                            Content="{DynamicResource TopLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[TopLeft].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[TopCenter].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.TopCenter}"
                            Content="{DynamicResource TopCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[TopCenter].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[TopRight].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.TopRight}"
                            Content="{DynamicResource TopRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[TopRight].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[MiddleLeft].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.MiddleLeft}"
                            Content="{DynamicResource MiddleLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[MiddleLeft].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[Center].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.Center}"
                            Content="{DynamicResource CenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[Center].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[MiddleRight].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.MiddleRight}"
                            Content="{DynamicResource MiddleRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[MiddleRight].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BottomLeft].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BottomLeft}"
                            Content="{DynamicResource BottomLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BottomLeft].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BottomCenter].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BottomCenter}"
                            Content="{DynamicResource BottomCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BottomCenter].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BottomRight].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BottomRight}"
                            Content="{DynamicResource BottomRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BottomRight].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="15,10,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Margin="1"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[RedColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.RedColor}"
                            Content="{DynamicResource RedPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[RedColor].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <Button
                            Grid.Column="1"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[GreenColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.GreenColor}"
                            Content="{DynamicResource GreenPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[GreenColor].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <Button
                            Grid.Column="2"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BlueColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BlueColor}"
                            Content="{DynamicResource BluePoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BlueColor].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <Button
                            Grid.Column="3"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[WhiteColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.WhiteColor}"
                            Content="{DynamicResource WhitePoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[WhiteColor].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Visibility="{Binding IsTvCheckboxChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            Grid.Column="4"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BlackColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BlackColor}"
                            Content="{DynamicResource BlackPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BlackColor].MeasuredValuesString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <TextBox
            x:Name="LogTextBox"
            Grid.Row="1"
            MinHeight="200"
            Margin="0,5,5,5"
            AcceptsReturn="True"
            Background="#FF2A2828"
            BorderBrush="White"
            BorderThickness="1"
            Foreground="White"
            HorizontalScrollBarVisibility="Disabled"
            IsReadOnly="True"
            Text="{Binding LogText, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto">
            <TextBox.ContextMenu>
                <ContextMenu>

                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                    <MenuItem Command="{Binding ClearLogCommand}" Header="{DynamicResource ClearLogWindow}" />
                    <Separator />
                    <MenuItem Command="ApplicationCommands.SelectAll" />
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>

        <Grid
            Grid.Row="2"
            Margin="0,5,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">

                <Button
                    Margin="5"
                    HorizontalAlignment="Left"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.ReportGenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="ReportGenerator.exe"
                    Content="{DynamicResource ReportButton}" />
                <Button
                    Margin="5"
                    HorizontalAlignment="Left"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.UploadReportsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource UploadButton}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="5"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.NewDeviceUnderTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource NewDeviceUnderTestButton}" />
                <Button
                    Margin="5"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.ClearFieldsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource ClearFieldsButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>