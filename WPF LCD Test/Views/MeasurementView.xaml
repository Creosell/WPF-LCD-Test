                        <Border
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Style="{StaticResource SpecVerdictChipStyle}">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource AppTextPrimary}"
                                Text="{Binding Spec.VerdictText}" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource AppTextSecondary}"
                            Text="{Binding Spec.ProgressText}" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Grid.IsSharedSizeScope="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Spec.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SpecRowStyle}" ToolTip="{Binding ToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SpecValue" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SpecBounds" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource SpecDotStyle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MinWidth="120"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="2"
                                                MinWidth="44"
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="{Binding ValueText}"
                                                TextAlignment="Right" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource AppTextSecondary}"
                                                Text="{Binding SpecText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        Grid.Row="2"
                        Margin="4,6,4,0"
                        FontSize="13"
                        Foreground="{DynamicResource AppTextSecondary}"
                        Text="{Binding Spec.HintText}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="0,5,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">

                <Button
                    x:Name="CreateReportButton"
                    behaviors:ActionFeedbackBehavior.Signal="{Binding ReportFeedback}"
                    behaviors:ActionFeedbackBehavior.SuccessText="FeedbackDone"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.ReportGenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="ReportGenerator.exe"
                    Style="{StaticResource CreateReportButtonStyle}" />
                <Button
                    x:Name="UploadReportsButton"
                    behaviors:ActionFeedbackBehavior.Signal="{Binding UploadFeedback}"
                    behaviors:ActionFeedbackBehavior.SuccessText="FeedbackUploaded"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.UploadReportsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource UploadReportsButtonStyle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    x:Name="SaveResultsButton"
                    behaviors:ActionFeedbackBehavior.Signal="{Binding SaveFeedback}"
                    behaviors:ActionFeedbackBehavior.SuccessText="FeedbackSaved"
                    Command="{Binding DataContext.NewDeviceUnderTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource NewDeviceUnderTestButton}"
                    Style="{StaticResource ActionButtonStyle}" />
                <Button
                    x:Name="ClearResultsButton"
                    behaviors:ActionFeedbackBehavior.Signal="{Binding ClearFeedback}"
                    behaviors:ActionFeedbackBehavior.SuccessText="FeedbackCleared"
                    Command="{Binding DataContext.ClearFieldsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource ClearFieldsButton}"
                    Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>