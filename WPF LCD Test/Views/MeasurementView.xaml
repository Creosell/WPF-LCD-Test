<UserControl
    x:Class="WPF_LCD_Test.Views.MeasurementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:behaviors="clr-namespace:WPF_LCD_Test.Views.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPF_LCD_Test.Models"
    xmlns:services="clr-namespace:WPF_LCD_Test.Services"
    xmlns:viewmodels="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MeasurementViewModel}"
    Background="{DynamicResource AppPageBackground}"
    Focusable="True"
    FontSize="{StaticResource AppFontSize}"
    Foreground="{DynamicResource AppTextPrimary}"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    PreviewMouseDown="UserControl_PreviewMouseDown"
    mc:Ignorable="d">
    <!--
        d:DesignHeight="600"
        d:DesignWidth="800"
    -->

    <UserControl.InputBindings>
        <KeyBinding
            Key="S"
            Command="{Binding NewDeviceUnderTestCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="R"
            Command="{Binding ReportGenerateCommand}"
            CommandParameter="ReportGenerator.exe"
            Modifiers="Control" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  A button of a cancelable action: while the action runs its label tells so and a second click cancels it  -->
        <Style
            x:Key="CreateReportButtonStyle"
            BasedOn="{StaticResource ActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Content" Value="{DynamicResource ReportButton}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsReportGenerating, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Content" Value="{DynamicResource ReportButtonBusy}" />
                    <Setter Property="ToolTip" Value="{DynamicResource CancelOnClickToolTip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="UploadReportsButtonStyle"
            BasedOn="{StaticResource ActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Content" Value="{DynamicResource UploadButton}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Mode=OneWay}" /><Run Text="{Binding DataContext.PendingReportsSuffix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsUploadingReports, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Content" Value="{DynamicResource UploadButtonBusy}" />
                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                    <Setter Property="ToolTip" Value="{DynamicResource CancelOnClickToolTip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  HierarchicalDataTemplate driving the cascading device configuration menu; propagates recursively to nested folder submenus.  -->
        <HierarchicalDataTemplate DataType="{x:Type models:DeviceConfigTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}" />
        </HierarchicalDataTemplate>

        <!--
            Compact MenuItem template: MaterialDesign's default MenuItem chrome reserves a wide fixed-width
            icon gutter on the left even when no Icon is set, which reads as an oversized indent for a plain
            text list. This template renders only a checkmark column (collapsed to zero width unless
            checked), the header text, and a submenu arrow (only when the item has children).
        -->
        <ControlTemplate x:Key="DeviceConfigMenuItemTemplate" TargetType="MenuItem">
            <Border
                x:Name="Bg"
                Padding="10,6"
                Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CheckGlyph"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="✓"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header" />
                    <Path
                        x:Name="SubmenuArrow"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Data="M0,0 L4,4 L0,8"
                        Fill="{TemplateBinding Foreground}"
                        Visibility="Collapsed" />
                    <Popup
                        x:Name="PART_Popup"
                        AllowsTransparency="False"
                        Focusable="False"
                        HorizontalOffset="10"
                        IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                        Placement="Right"
                        PopupAnimation="None"
                        VerticalOffset="-6">
                        <Border
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource AppControlBorder}"
                            BorderThickness="1">
                            <ItemsPresenter />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppHoverOverlay}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
            MaterialDesign assigns ContextMenu/MenuItem its own default ItemContainerStyle, which takes
            precedence over any implicit (unkeyed) TargetType="MenuItem" style for generated containers.
            This style must therefore be applied explicitly via ItemContainerStyle, and re-applies itself
            to its own ItemContainerStyle so it keeps propagating into nested folder submenus.
            
            Selection itself stays on Command/CommandParameter (bound to the ViewModel's
            SelectDeviceConfigurationCommand), keeping the MVVM action in the ViewModel. The Click
            EventSetter is only a bridge invoking that already-bound Command: containers generated
            inside a ContextMenu's nested Popups do not reliably raise ICommandSource execution on
            their own in this MaterialDesign setup, so the bridge forces it explicitly.
        -->
        <!--
            Analyzer state indicator: gray - not connected, amber (breathing) - connected and calibrating,
            green - connected and calibrated
        -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource AppTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource ResultWarnDot}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeviceCalibrated}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource ResultOkDot}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDeviceConnected}" Value="True" />
                        <Condition Binding="{Binding IsDeviceCalibrated}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BreathingStoryboard">
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="True"
                                    RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0.3"
                                    Duration="0:0:0.8">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BreathingStoryboard" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceConfigMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template" Value="{StaticResource DeviceConfigMenuItemTemplate}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DeviceConfigMenuItemStyle}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="CommandParameter" Value="{Binding RelativePath}" />
            <EventSetter Event="Click" Handler="DeviceConfigMenuItem_Click" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter Property="IsCheckable" Value="True" />
                    <Setter Property="IsChecked" Value="{Binding IsSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Badge on a measurement button: the specification check has a remark about the accepted measurement of
            that point (amber exclamation mark - below typ, red cross - outside min/max). The DataContext is the
            MeasurementStatus of the point; the badge is hidden while the point holds no accepted measurement.
        -->
        <Style x:Key="SpecBadgeStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ToolTip" Value="{Binding SpecTooltip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Ellipse
                                x:Name="Dot"
                                Fill="{DynamicResource StatusWarnDot}"
                                Stroke="{DynamicResource AppPageBackground}"
                                StrokeThickness="2" />
                            <TextBlock
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#1E1E1E"
                                Text="!" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SpecBadge}" Value="Fail">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource StatusErrDot}" />
                                <Setter TargetName="Glyph" Property="FontFamily" Value="Segoe UI Symbol" />
                                <Setter TargetName="Glyph" Property="FontSize" Value="10" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#x2716;" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpecBadge}" Value="Warning">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SpecBadge}" Value="Fail">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Row of the device info table: tinted by the check status  -->
        <Style x:Key="SpecRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource StatusWarnPlate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Background" Value="{DynamicResource StatusErrPlate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unavailable">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Row of the results table: the dot and the tint follow the status of the point  -->
        <Style x:Key="ResultRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource StatusErrPlate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="{x:Null}">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Attempts counter: dim dash, amber below three attempts, green from three  -->
        <Style x:Key="TriesTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TriesLevel}" Value="Few">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TriesLevel}" Value="Enough">
                    <Setter Property="Foreground" Value="{DynamicResource StatusOkText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource AppTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource StatusOkDot}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="False">
                    <Setter Property="Fill" Value="{DynamicResource StatusErrDot}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Color of a log line by its severity  -->
        <Style x:Key="LogMessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppLogText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Row of the log: a colored plate with a bar on the left for warnings and errors in the light theme
            (the dark theme defines these brushes transparent and the bar thickness zero)
        -->
        <Style x:Key="LogRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="BorderThickness" Value="{DynamicResource LogBarThickness}" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource LogWarnBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LogWarnBar}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource LogErrBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LogErrBar}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Count of warnings and errors added while the Log tab was not shown; amber, red when any of them is an error  -->
        <Style x:Key="UnreadBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource StatusWarnDot}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UnreadSeverity}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource StatusErrDot}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UnreadIssues}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpecDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource AppTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pass">
                    <Setter Property="Fill" Value="{DynamicResource StatusOkDot}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Fill" Value="{DynamicResource StatusWarnDot}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Fill" Value="{DynamicResource StatusErrDot}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpecVerdictChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusOkDot}" />
            <Setter Property="Background" Value="{DynamicResource StatusOkPlate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Spec.Verdict}" Value="Warn">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarnDot}" />
                    <Setter Property="Background" Value="{DynamicResource StatusWarnPlate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Spec.Verdict}" Value="Fail">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrDot}" />
                    <Setter Property="Background" Value="{DynamicResource StatusErrPlate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Spec.VerdictText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="MeasurementButtonsStyle"
            BasedOn="{StaticResource MaterialDesignFlatDarkBgButton}"
            TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MaterialDesign:ButtonAssist.CornerRadius" Value="15" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="50*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*" />
                <ColumnDefinition Width="55*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button
                        Command="{Binding DataContext.ZeroCalibrationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Content="{DynamicResource ZeroCalibration}"
                        Style="{StaticResource ActionButtonStyle}" />
                    <Border
                        x:Name="DeviceCard"
                        Height="52"
                        Margin="10,5,10,5"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppCardBackground}"
                        BorderBrush="{DynamicResource AppCardBorder}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="12"
                        ToolTip="{Binding DeviceStateText}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDotStyle}" />
                            <Grid
                                x:Name="DeviceCardContent"
                                VerticalAlignment="Center"
                                Tag="NotConnected">
                                <!--  Not connected: hint what to do  -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=DeviceCardContent}" Value="NotConnected">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Foreground="{DynamicResource AppTextPrimary}" Text="{DynamicResource DeviceCardNoAnalyzer}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource AppTextSecondary}"
                                        Text="{DynamicResource DeviceCardPressCalibration}" />
                                </StackPanel>
                                <!--  Connected, the channel is not confirmed yet  -->
                                <TextBlock Foreground="{DynamicResource AppTextSecondary}" Text="{DynamicResource DeviceCardCalibrating}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=DeviceCardContent}" Value="Calibrating">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!--  Channel confirmed: model, channel and probe serial number  -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=DeviceCardContent}" Value="Ready">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AppTextPrimary}"
                                            Text="{Binding DeviceModelName}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Foreground="{DynamicResource AppTextSecondary}"
                                            Text="{Binding DeviceActiveChannelStatusText}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource AppTextSecondary}"
                                        Text="{Binding DeviceProbeSerialText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource DeviceConfiguration}"
                            Foreground="{DynamicResource AppTextPrimary}" />
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Button
                                x:Name="DeviceConfigurationButton"
                                MinHeight="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="DeviceConfigurationButton_Click"
                                Foreground="{DynamicResource AppTextPrimary}"
                                Style="{StaticResource UnderlinedDropdownButtonStyle}"
                                Tag="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu
                                        DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                        ItemContainerStyle="{StaticResource DeviceConfigMenuItemStyle}"
                                        ItemsSource="{Binding DeviceConfigurationTree}"
                                        Placement="Bottom" />
                                </Button.ContextMenu>
                                <Grid>
                                    <!--  Invisible copy of every text the button can show: it makes the button as wide as the longest of them  -->
                                    <ItemsControl
                                        Height="0"
                                        Margin="24,0"
                                        Focusable="False"
                                        FontStyle="Italic"
                                        IsHitTestVisible="False"
                                        IsTabStop="False"
                                        ItemsSource="{Binding DeviceConfigurationCaptions}"
                                        Visibility="Hidden">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="24,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Text="{Binding SelectedDeviceConfigurationDisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedDeviceConfiguration}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <MaterialDesign:PackIcon
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Kind="ChevronDown" />
                                </Grid>
                            </Button>
                            <!--  The feedback line lies over the underline of the field so the hover line of the field cannot hide it  -->
                            <Border
                                Height="1"
                                VerticalAlignment="Bottom"
                                behaviors:ActionFeedbackBehavior.Mode="Overlay"
                                behaviors:ActionFeedbackBehavior.Signal="{Binding ConfigFeedback}"
                                IsHitTestVisible="False" />
                        </Grid>



                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource SerialNumber}"
                            Foreground="{DynamicResource AppTextLabel}" />
                        <Grid Margin="5" VerticalAlignment="Center">
                            <TextBox
                                x:Name="SerialNumberTextBox"
                                MinWidth="200"
                                Margin="0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AppTextPrimary}"
                                LostFocus="SerialNumberTextBox_LostFocus"
                                Style="{StaticResource UnderlinedTextBoxStyle}"
                                Text="{Binding SerialNumber, UpdateSourceTrigger=Explicit}">
                                <TextBox.InputBindings>
                                    <KeyBinding
                                        Key="Enter"
                                        Command="{Binding DataContext.ApplySerialNumberCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding Text, ElementName=SerialNumberTextBox}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <!--  The feedback line lies over the underline of the field so the hover highlight of the field cannot hide it  -->
