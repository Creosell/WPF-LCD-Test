                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Line" Property="Height" Value="3" />
                                            <Setter TargetName="Line" Property="Fill" Value="#9575CD" />
                                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="Bold" />
