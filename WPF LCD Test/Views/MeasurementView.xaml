<UserControl
    x:Class="WPF_LCD_Test.Views.MeasurementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_LCD_Test"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:WPF_LCD_Test.Resources"
    xmlns:services="clr-namespace:WPF_LCD_Test.Services"
    xmlns:v="clr-namespace:WPF_LCD_Test.Views"
    xmlns:vm="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MeasurementViewModel}"
    Background="#FF424242"
    Focusable="True"
    FontSize="15"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    PreviewMouseDown="UserControl_PreviewMouseDown"
    mc:Ignorable="d">
    <!--
        d:DesignHeight="600"
        d:DesignWidth="800"
    -->

    <UserControl.Resources>
        <Style
            x:Key="MeasurementButtonsStyle"
            BasedOn="{StaticResource MaterialDesignFlatDarkBgButton}"
            TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="MaterialDesign:ButtonAssist.CornerRadius" Value="15" />
        </Style>
    </UserControl.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="50*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="60*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button
                        Margin="5"
                        MaterialDesign:ButtonAssist.CornerRadius="15"
                        Command="{Binding DataContext.ZeroCalibrationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Content="{DynamicResource ZeroCalibration}" />
                    <StackPanel
                        Margin="20,0,10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding DeviceConnectionStatusText}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding DeviceCalibrationStatusText}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource MeasurementTimeSec}"
                            Foreground="#E5FFFFFF" />
                        <TextBox
                            x:Name="MeasurementTimeTextBox"
                            MinWidth="40"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            LostFocus="MeasurementTimeTextBox_LostFocus"
                            Text="{Binding MeasurementTime, UpdateSourceTrigger=Explicit}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding DataContext.ApplyMeasurementTimeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Text, ElementName=MeasurementTimeTextBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource SerialNumber}"
                            Foreground="#E5FFFFFF" />
                        <TextBox
                            x:Name="SerialNumberTextBox"
                            MinWidth="180"
                            Margin="5"
                            VerticalAlignment="Center"
                            Foreground="White"
                            LostFocus="SerialNumberTextBox_LostFocus"
                            Text="{Binding SerialNumber, UpdateSourceTrigger=Explicit}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding DataContext.ApplySerialNumberCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Text, ElementName=SerialNumberTextBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).TopLeftStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).TopLeftStatus.Location}"
                            Content="{DynamicResource TopLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).TopLeftStatus.MeasuredValuesString}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).TopCenterStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).TopCenterStatus.Location}"
                            Content="{DynamicResource TopCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).TopCenterStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).TopRightStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).TopRightStatus.Location}"
                            Content="{DynamicResource TopRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).TopRightStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).MiddleLeftStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).MiddleLeftStatus.Location}"
                            Content="{DynamicResource MiddleLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).MiddleLeftStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).CenterStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).CenterStatus.Location}"
                            Content="{DynamicResource CenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).CenterStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).MiddleRightStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).MiddleRightStatus.Location}"
                            Content="{DynamicResource MiddleRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).MiddleRightStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).BottomLeftStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).BottomLeftStatus.Location}"
                            Content="{DynamicResource BottomLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).BottomLeftStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).BottomCenterStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).BottomCenterStatus.Location}"
                            Content="{DynamicResource BottomCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).BottomCenterStatus.MeasuredValuesString}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).BottomRightStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).BottomRightStatus.Location}"
                            Content="{DynamicResource BottomRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).BottomRightStatus.MeasuredValuesString}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="15,10,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="25*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Margin="1"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).RedColorStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).RedColorStatus.Location}"
                            Content="{DynamicResource RedPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).RedColorStatus.MeasuredValuesString}" />
                        <Button
                            Grid.Column="1"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).GreenColorStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).GreenColorStatus.Location}"
                            Content="{DynamicResource GreenPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).GreenColorStatus.MeasuredValuesString}" />
                        <Button
                            Grid.Column="2"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).BlueColorStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).BlueColorStatus.Location}"
                            Content="{DynamicResource BluePoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).BlueColorStatus.MeasuredValuesString}" />
                        <Button
                            Grid.Column="3"
                            Background="{Binding Path=(services:MeasurementStatusManager.Instance).BlackColorStatus.StatusColor}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding Path=(services:MeasurementStatusManager.Instance).BlackColorStatus.Location}"
                            Content="{DynamicResource BlackPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding Path=(services:MeasurementStatusManager.Instance).BlackColorStatus.MeasuredValuesString}" />
                    </Grid>

                </Grid>
            </Grid>
        </Grid>



        <TextBox
            x:Name="LogTextBox"
            Grid.Row="1"
            MinHeight="200"
            Margin="0,5,5,5"
            AcceptsReturn="True"
            Background="#FF2A2828"
            BorderBrush="White"
            BorderThickness="1"
            Foreground="White"
            HorizontalScrollBarVisibility="Disabled"
            IsReadOnly="True"
            Text="{Binding LogText, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto">
            <TextBox.ContextMenu>
                <ContextMenu>

                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                    <MenuItem Command="{Binding ClearLogCommand}" Header="{DynamicResource ClearLogWindow}" />
                    <Separator />
                    <MenuItem Command="ApplicationCommands.SelectAll" />





                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>

        <Grid
            Grid.Row="2"
            Margin="0,5,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="5"
                HorizontalAlignment="Left"
                MaterialDesign:ButtonAssist.CornerRadius="15"
                Command="{Binding DataContext.LaunchExternalProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="{DynamicResource ReportButton}" />
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="5"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.NewDeviceUnderTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource NewDeviceUnderTestButton}" />
                <Button
                    Margin="5"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.ClearFieldsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource ClearFieldsButton}" />
            </StackPanel>
        </Grid>








    </Grid>
</UserControl>