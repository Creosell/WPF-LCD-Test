<UserControl
    x:Class="WPF_LCD_Test.Views.MeasurementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPF_LCD_Test.Models"
    xmlns:services="clr-namespace:WPF_LCD_Test.Services"
    xmlns:viewmodels="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MeasurementViewModel}"
    Background="#FF424242"
    Focusable="True"
    FontSize="15"
    Foreground="White"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    PreviewMouseDown="UserControl_PreviewMouseDown"
    mc:Ignorable="d">
    <!--
        d:DesignHeight="600"
        d:DesignWidth="800"
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  HierarchicalDataTemplate driving the cascading device configuration menu; propagates recursively to nested folder submenus.  -->
        <HierarchicalDataTemplate DataType="{x:Type models:DeviceConfigTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}" />
        </HierarchicalDataTemplate>

        <!--
            Compact MenuItem template: MaterialDesign's default MenuItem chrome reserves a wide fixed-width
            icon gutter on the left even when no Icon is set, which reads as an oversized indent for a plain
            text list. This template renders only a checkmark column (collapsed to zero width unless
            checked), the header text, and a submenu arrow (only when the item has children).
        -->
        <ControlTemplate x:Key="DeviceConfigMenuItemTemplate" TargetType="MenuItem">
            <Border
                x:Name="Bg"
                Padding="10,6"
                Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CheckGlyph"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="✓"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header" />
                    <Path
                        x:Name="SubmenuArrow"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Data="M0,0 L4,4 L0,8"
                        Fill="{TemplateBinding Foreground}"
                        Visibility="Collapsed" />
                    <Popup
                        x:Name="PART_Popup"
                        AllowsTransparency="False"
                        Focusable="False"
                        HorizontalOffset="10"
                        IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                        Placement="Right"
                        PopupAnimation="None"
                        VerticalOffset="-6">
                        <Border
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="#FFAAAAAA"
                            BorderThickness="1">
                            <ItemsPresenter />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
            MaterialDesign assigns ContextMenu/MenuItem its own default ItemContainerStyle, which takes
            precedence over any implicit (unkeyed) TargetType="MenuItem" style for generated containers.
            This style must therefore be applied explicitly via ItemContainerStyle, and re-applies itself
            to its own ItemContainerStyle so it keeps propagating into nested folder submenus.
            
            Selection itself stays on Command/CommandParameter (bound to the ViewModel's
            SelectDeviceConfigurationCommand), keeping the MVVM action in the ViewModel. The Click
            EventSetter is only a bridge invoking that already-bound Command: containers generated
            inside a ContextMenu's nested Popups do not reliably raise ICommandSource execution on
            their own in this MaterialDesign setup, so the bridge forces it explicitly.
        -->
        <!--
            Analyzer state indicator: gray - not connected, amber (breathing) - connected and calibrating,
            green - connected and calibrated
        -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                    <Setter Property="Fill" Value="#FFB020" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeviceCalibrated}" Value="True">
                    <Setter Property="Fill" Value="#4CD964" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDeviceConnected}" Value="True" />
                        <Condition Binding="{Binding IsDeviceCalibrated}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BreathingStoryboard">
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="True"
                                    RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0.3"
                                    Duration="0:0:0.8">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BreathingStoryboard" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceConfigMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Template" Value="{StaticResource DeviceConfigMenuItemTemplate}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DeviceConfigMenuItemStyle}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="CommandParameter" Value="{Binding RelativePath}" />
            <EventSetter Event="Click" Handler="DeviceConfigMenuItem_Click" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter Property="IsCheckable" Value="True" />
                    <Setter Property="IsChecked" Value="{Binding IsSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            MaterialDesignFlatButton fills the entire button area on hover (a ripple-style highlight),
            which reads as inconsistent next to the plain underline hover of the SN TextBox. This template
            keeps only a bottom underline that brightens on hover, matching the TextBox's affordance.
        -->
        <Style x:Key="DeviceConfigDropdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Underline"
                            BorderBrush="Black"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="0,0,0,4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Badge on a measurement button: the specification check has a remark about the accepted measurement of
            that point (amber exclamation mark - below typ, red cross - outside min/max). The DataContext is the
            MeasurementStatus of the point; the badge is hidden while the point holds no accepted measurement.
        -->
        <Style x:Key="SpecBadgeStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ToolTip" Value="{Binding SpecTooltip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Ellipse
                                x:Name="Dot"
                                Fill="#FFC107"
                                Stroke="#FF424242"
                                StrokeThickness="2" />
                            <TextBlock
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#1E1E1E"
                                Text="!" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SpecBadge}" Value="Fail">
                                <Setter TargetName="Dot" Property="Fill" Value="#FF5252" />
                                <Setter TargetName="Glyph" Property="FontFamily" Value="Segoe UI Symbol" />
                                <Setter TargetName="Glyph" Property="FontSize" Value="10" />
                                <Setter TargetName="Glyph" Property="Text" Value="&#x2716;" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpecBadge}" Value="Warning">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SpecBadge}" Value="Fail">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Row of the device info table: tinted by the check status  -->
        <Style x:Key="SpecRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#33FFC107" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Background" Value="#33FF5252" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unavailable">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Row of the results table: the dot and the tint follow the status of the point  -->
        <Style x:Key="ResultRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="False">
                    <Setter Property="Background" Value="#33FF5252" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="{x:Null}">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="True">
                    <Setter Property="Fill" Value="#4CAF50" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.IsPassed}" Value="False">
                    <Setter Property="Fill" Value="#FF5252" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Color of a log line by its severity  -->
        <Style x:Key="LogMessageStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1E1E1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Foreground" Value="#FFC107" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Foreground" Value="#FF5252" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Count of warnings and errors added while the Log tab was not shown  -->
        <Style x:Key="UnreadBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#FF5252" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UnreadIssues}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpecDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pass">
                    <Setter Property="Fill" Value="#4CAF50" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Fill" Value="#FFC107" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Fill" Value="#FF5252" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpecVerdictChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4CAF50" />
            <Setter Property="Background" Value="#334CAF50" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Spec.Verdict}" Value="Warn">
                    <Setter Property="BorderBrush" Value="#FFC107" />
                    <Setter Property="Background" Value="#33FFC107" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Spec.Verdict}" Value="Fail">
                    <Setter Property="BorderBrush" Value="#FF5252" />
                    <Setter Property="Background" Value="#33FF5252" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Spec.VerdictText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="MeasurementButtonsStyle"
            BasedOn="{StaticResource MaterialDesignFlatDarkBgButton}"
            TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="MaterialDesign:ButtonAssist.CornerRadius" Value="15" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="50*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*" />
                <ColumnDefinition Width="55*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button
                        Margin="5"
                        MaterialDesign:ButtonAssist.CornerRadius="15"
                        Command="{Binding DataContext.ZeroCalibrationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        Content="{DynamicResource ZeroCalibration}" />
                    <Border
                        x:Name="DeviceCard"
                        Height="52"
                        Margin="10,5,10,5"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Background="#26000000"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="12"
                        ToolTip="{Binding DeviceStateText}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDotStyle}" />
                            <Grid
                                x:Name="DeviceCardContent"
                                VerticalAlignment="Center"
                                Tag="NotConnected">
                                <!--  Not connected: hint what to do  -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=DeviceCardContent}" Value="NotConnected">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Foreground="White" Text="{DynamicResource DeviceCardNoAnalyzer}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#B5FFFFFF"
                                        Text="{DynamicResource DeviceCardPressCalibration}" />
                                </StackPanel>
                                <!--  Connected, the channel is not confirmed yet  -->
                                <TextBlock Foreground="#B5FFFFFF" Text="{DynamicResource DeviceCardCalibrating}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=DeviceCardContent}" Value="Calibrating">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!--  Channel confirmed: model, channel and probe serial number  -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=DeviceCardContent}" Value="Ready">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding DeviceModelName}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Foreground="#B5FFFFFF"
                                            Text="{Binding DeviceActiveChannelStatusText}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#B5FFFFFF"
                                        Text="{Binding DeviceProbeSerialText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource DeviceConfiguration}"
                            Foreground="White" />
                        <Button
                            x:Name="DeviceConfigurationButton"
                            MinWidth="200"
                            MinHeight="20"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="DeviceConfigurationButton_Click"
                            Foreground="White"
                            Style="{StaticResource DeviceConfigDropdownButtonStyle}"
                            Tag="{Binding}">
                            <Button.ContextMenu>
                                <ContextMenu
                                    DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                    ItemContainerStyle="{StaticResource DeviceConfigMenuItemStyle}"
                                    ItemsSource="{Binding DeviceConfigurationTree}"
                                    Placement="Bottom" />
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    Text="{Binding SelectedDeviceConfigurationDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedDeviceConfiguration}" Value="False">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <MaterialDesign:PackIcon
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="ChevronDown" />
                            </StackPanel>
                        </Button>



                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource SerialNumber}"
                            Foreground="#E5FFFFFF" />
                        <TextBox
                            x:Name="SerialNumberTextBox"
                            MinWidth="200"
                            Margin="5"
                            VerticalAlignment="Center"
                            Foreground="White"
                            LostFocus="SerialNumberTextBox_LostFocus"
                            Text="{Binding SerialNumber, UpdateSourceTrigger=Explicit}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding DataContext.ApplySerialNumberCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Text, ElementName=SerialNumberTextBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label Content="{DynamicResource TV}" Foreground="White" />
                        <CheckBox Margin="5" IsChecked="{Binding IsTvCheckboxChecked}" />
                    </StackPanel>
                </Grid>
            </Grid>


            <Grid Grid.Column="1" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[TopLeft].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.TopLeft}"
                            Content="{DynamicResource TopLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[TopLeft].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="0"
                            Grid.Column="0"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[TopLeft], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[TopCenter].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.TopCenter}"
                            Content="{DynamicResource TopCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[TopCenter].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="0"
                            Grid.Column="1"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[TopCenter], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[TopRight].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.TopRight}"
                            Content="{DynamicResource TopRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[TopRight].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="0"
                            Grid.Column="2"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[TopRight], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[MiddleLeft].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.MiddleLeft}"
                            Content="{DynamicResource MiddleLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[MiddleLeft].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="0"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[MiddleLeft], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[Center].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.Center}"
                            Content="{DynamicResource CenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[Center].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="1"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[Center], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[MiddleRight].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.MiddleRight}"
                            Content="{DynamicResource MiddleRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[MiddleRight].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="2"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[MiddleRight], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BottomLeft].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BottomLeft}"
                            Content="{DynamicResource BottomLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BottomLeft].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="2"
                            Grid.Column="0"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[BottomLeft], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BottomCenter].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BottomCenter}"
                            Content="{DynamicResource BottomCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BottomCenter].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="2"
                            Grid.Column="1"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[BottomCenter], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="5"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BottomRight].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BottomRight}"
                            Content="{DynamicResource BottomRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BottomRight].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Row="2"
                            Grid.Column="2"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[BottomRight], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Margin="15,10,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="10*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Margin="1"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[RedColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.RedColor}"
                            Content="{DynamicResource RedPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[RedColor].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Column="0"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[RedColor], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                        <Button
                            Grid.Column="1"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[GreenColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.GreenColor}"
                            Content="{DynamicResource GreenPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[GreenColor].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Column="1"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[GreenColor], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                        <Button
                            Grid.Column="2"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BlueColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BlueColor}"
                            Content="{DynamicResource BluePoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BlueColor].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Column="2"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[BlueColor], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                        <Button
                            Grid.Column="3"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[WhiteColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.WhiteColor}"
                            Content="{DynamicResource WhitePoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[WhiteColor].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Visibility="{Binding IsTvCheckboxChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ContentControl
                            Grid.Column="3"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[WhiteColor], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                        <Button
                            Grid.Column="4"
                            Background="{Binding DataContext.MeasurementStatusService.Statuses[BlackColor].StatusColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{x:Static models:MeasurementLocation.BlackColor}"
                            Content="{DynamicResource BlackPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}"
                            ToolTip="{Binding DataContext.MeasurementStatusService.Statuses[BlackColor].MeasuredValuesToolTip, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <ContentControl
                            Grid.Column="4"
                            DataContext="{Binding DataContext.MeasurementStatusService.Statuses[BlackColor], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            Style="{StaticResource SpecBadgeStyle}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" MinHeight="200" Margin="0,5,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*" />
                <ColumnDefinition Width="55*" />
            </Grid.ColumnDefinitions>
            <TabControl
                Grid.Column="0"
                Margin="0,0,5,0"
                Padding="0"
                Background="#FF2A2828"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                BorderThickness="1"
                SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Resources>
                    <Style BasedOn="{StaticResource MaterialDesignTabItem}" TargetType="TabItem">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock FontSize="14" Text="{DynamicResource ResultsTab}" />
                    </TabItem.Header>
                    <Grid Margin="8,4,8,6" Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="6,0,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ResultName" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Margin="0,0,10,0" Fill="Transparent" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="#B5FFFFFF"
                                Text="{DynamicResource ResultsColumnPoint}" />
                            <TextBlock Grid.Column="2" Margin="0,0,6,0" FontSize="12" Foreground="#B5FFFFFF" Text="x" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Margin="0,0,6,0" FontSize="12" Foreground="#B5FFFFFF" Text="y" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Margin="0,0,6,0" FontSize="12" Foreground="#B5FFFFFF" Text="Lv" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Margin="0,0,6,0" FontSize="12" Foreground="#B5FFFFFF" Text="T" TextAlignment="Right" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ResultRowStyle}" ToolTip="{Binding Status.MeasuredValuesToolTip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ResultName" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Style="{StaticResource ResultDotStyle}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" Text="{Binding X}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Y}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Lv}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="5" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" Text="{Binding T}" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Text="{DynamicResource LogTab}" />
                            <Border Style="{StaticResource UnreadBadgeStyle}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#1E1E1E"
                                    Text="{Binding UnreadIssues}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer
                        x:Name="LogScrollViewer"
                        Margin="8,6"
                        VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="CopyLog_Click" Header="{DynamicResource CopyLogWindow}" />
                                <MenuItem Command="{Binding ClearLogCommand}" Header="{DynamicResource ClearLogWindow}" />
                            </ContextMenu>
                        </ScrollViewer.ContextMenu>
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Foreground="#8A8A8A"
                                            Text="{Binding TimeText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="14"
                                            Style="{StaticResource LogMessageStyle}"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border
                Grid.Column="1"
                Margin="5,0,0,0"
                Background="#FF2C2C2C"
                BorderBrush="#FF5A5A5A"
                BorderThickness="1"
                CornerRadius="4">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{DynamicResource SpecPanelTitle}" />
                        <Border
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Style="{StaticResource SpecVerdictChipStyle}">
                            <TextBlock
                                FontSize="13"
                                Foreground="White"
                                Text="{Binding Spec.VerdictText}" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#B5FFFFFF"
                            Text="{Binding Spec.ProgressText}" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Grid.IsSharedSizeScope="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Spec.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SpecRowStyle}" ToolTip="{Binding ToolTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SpecValue" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SpecBounds" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource SpecDotStyle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MinWidth="120"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="2"
                                                MinWidth="44"
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="{Binding ValueText}"
                                                TextAlignment="Right" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="#B5FFFFFF"
                                                Text="{Binding SpecText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        Grid.Row="2"
                        Margin="4,6,4,0"
                        FontSize="13"
                        Foreground="#B5FFFFFF"
                        Text="{Binding Spec.HintText}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="0,5,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">

                <Button
                    Margin="5"
                    HorizontalAlignment="Left"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.ReportGenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="ReportGenerator.exe"
                    Content="{DynamicResource ReportButton}" />
                <Button
                    Margin="5"
                    HorizontalAlignment="Left"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.UploadReportsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource UploadButton}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="5"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.NewDeviceUnderTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource NewDeviceUnderTestButton}" />
                <Button
                    Margin="5"
                    MaterialDesign:ButtonAssist.CornerRadius="15"
                    Command="{Binding DataContext.ClearFieldsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{DynamicResource ClearFieldsButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>