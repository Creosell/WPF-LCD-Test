<Window
    x:Class="WPF_LCD_Test.Views.ChoiceDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="520"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock
            x:Name="MessageText"
            Margin="0,0,0,20"
            TextWrapping="Wrap" />
        <Button
            x:Name="FirstButton"
            Margin="0,0,0,8"
            Click="FirstButton_Click" />
        <Button x:Name="SecondButton" Click="SecondButton_Click" />
    </StackPanel>
</Window>
