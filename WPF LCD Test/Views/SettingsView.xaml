<UserControl
    x:Class="WPF_LCD_Test.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:behaviors="clr-namespace:WPF_LCD_Test.Views.Behaviors"
    xmlns:local="clr-namespace:WPF_LCD_Test.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource AppPageBackground}"
    Focusable="True"
    FontSize="{StaticResource AppFontSize}"
    Foreground="{DynamicResource AppTextPrimary}"
    PreviewMouseDown="UserControl_PreviewMouseDown"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="S"
            Command="{Binding SaveSettingsCommand}"
            Modifiers="Control" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="20"
                FontWeight="Bold"
                Text="{DynamicResource SettingsTitle}" />


            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="200"
                    VerticalAlignment="Center"
                    Content="{DynamicResource LanguageMenu}"
                    Foreground="{DynamicResource AppTextPrimary}" />
                <ComboBox
                    Style="{StaticResource UnderlinedComboBoxStyle}"
                    DropDownClosed="ComboBox_DropDownClosed"
                    Width="200"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding AvailableLanguages}"
                    SelectedItem="{Binding SelectedLanguage}"
                    SelectedValue="{Binding LanguageCultureCode, Mode=TwoWay}"
                    SelectedValuePath="CultureCode" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="200"
                    VerticalAlignment="Center"
                    Content="{DynamicResource ThemeLabel}"
                    Foreground="{DynamicResource AppTextPrimary}" />
                <ComboBox
                    Style="{StaticResource UnderlinedComboBoxStyle}"
                    Width="200"
                    DisplayMemberPath="DisplayName"
                    DropDownClosed="ComboBox_DropDownClosed"
                    ItemsSource="{Binding AvailableThemes}"
                    SelectedItem="{Binding SelectedTheme}" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="200"
                    VerticalAlignment="Center"
                    Content="{DynamicResource ColorAnalyzerChannel}"
                    Foreground="{DynamicResource AppTextPrimary}" />
                <TextBox
                    Style="{StaticResource UnderlinedTextBoxStyle}"
                    x:Name="ColorAnalyzerChannelTextBox"
                    MinWidth="30"
                    Margin="0,5"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource AppTextPrimary}"
                    Text="{Binding ColorAnalyzerChannel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    TextAlignment="Center" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="200"
                    VerticalAlignment="Center"
                    Content="{DynamicResource MeasurementSpeedLabel}"
                    Foreground="{DynamicResource AppTextPrimary}" />
                <ComboBox
                    Style="{StaticResource UnderlinedComboBoxStyle}"
                    DropDownClosed="ComboBox_DropDownClosed"
                    Width="120"
                    ItemsSource="{Binding AvailableMeasurementSpeeds}"
                    SelectedItem="{Binding MeasurementSpeed}" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="200"
                    VerticalAlignment="Center"
                    Content="{DynamicResource SyncModeLabel}"
                    Foreground="{DynamicResource AppTextPrimary}" />
                <ComboBox
                    Style="{StaticResource UnderlinedComboBoxStyle}"
                    DropDownClosed="ComboBox_DropDownClosed"
                    Width="120"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding AvailableSyncModes}"
                    SelectedValue="{Binding SelectedSyncMode}"
                    SelectedValuePath="Mode" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSyncFrequencyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox
                        Style="{StaticResource UnderlinedTextBoxStyle}"
                        MinWidth="50"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="{DynamicResource AppTextPrimary}"
                        Text="{Binding SyncFrequency, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        TextAlignment="Center"
                        ToolTip="{Binding SyncFrequencyHint}" />
                    <Label
                        VerticalAlignment="Center"
                        Content="Hz"
                        Foreground="{DynamicResource AppTextPrimary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsIntegrationTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox
                        Style="{StaticResource UnderlinedTextBoxStyle}"
                        MinWidth="50"
                        Margin="10,5,0,5"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="{DynamicResource AppTextPrimary}"
                        Text="{Binding IntegrationTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        TextAlignment="Center"
                        ToolTip="{Binding IntegrationTimeHint}" />
                    <Label
                        VerticalAlignment="Center"
                        Content="ms"
                        Foreground="{DynamicResource AppTextPrimary}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    behaviors:ActionFeedbackBehavior.Signal="{Binding SaveFeedback}"
                    behaviors:ActionFeedbackBehavior.SuccessText="FeedbackSaved"
                    Command="{Binding SaveSettingsCommand}"
                    Content="{DynamicResource SaveButton}"
                    Style="{StaticResource ActionButtonStyle}" />
                <Button
                    behaviors:ActionFeedbackBehavior.Signal="{Binding ResetFeedback}"
                    behaviors:ActionFeedbackBehavior.SuccessText="FeedbackReset"
                    Command="{Binding ResetToDefaultCommand}"
                    Content="{DynamicResource ResetToDefaultButton}"
                    Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>