<UserControl
    x:Class="WPF_LCD_Test.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_LCD_Test.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#FF424242"
    Foreground="White"
    mc:Ignorable="d">



    <Grid>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="20"
                FontWeight="Bold"
                Text="{DynamicResource SettingsTitle}" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label Content="{DynamicResource MeasurementTimeSec}" Foreground="White" />
                <TextBox
                    x:Name="MeasurementTimeTextBox"
                    MinWidth="40"
                    Foreground="White"
                    Text="{Binding MeasurementTime, UpdateSourceTrigger=Explicit, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                    LostFocus="MeasurementTimeTextBox_LostFocus">
                    <TextBox.InputBindings>
                        <KeyBinding
                            Key="Enter"
                            Command="{Binding ApplyMeasurementTimeCommand}"
                            CommandParameter="{Binding Text, ElementName=MeasurementTimeTextBox}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="120"
                    Content="{DynamicResource AutoConnectLabel}"
                    Foreground="White" />
                <CheckBox IsChecked="{Binding AutoConnectEnabled}" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Label
                    Width="120"
                    Content="{DynamicResource LanguageMenu}"
                    Foreground="White" />
                <ComboBox
                    Width="200"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding AvailableLanguages}"
                    SelectedItem="{Binding SelectedLanguage}"
                    SelectedValue="{Binding LanguageCultureCode, Mode=TwoWay}"
                    SelectedValuePath="CultureCode" />
            </StackPanel>

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="5,0"
                    Command="{Binding SaveSettingsCommand}"
                    Content="{DynamicResource SaveButton}" />
                <Button
                    Margin="5,0"
                    Command="{Binding CancelSettingsCommand}"
                    Content="{DynamicResource CancelButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>