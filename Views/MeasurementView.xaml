<UserControl
    x:Class="WPF_LCD_Test.Views.MeasurementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_LCD_Test"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:WPF_LCD_Test.Resources"
    xmlns:v="clr-namespace:WPF_LCD_Test.Views"
    xmlns:vm="clr-namespace:WPF_LCD_Test.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MeasurementViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="#FF424242"
    Focusable="True"
    FontSize="15"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    PreviewMouseDown="UserControl_PreviewMouseDown"
    mc:Ignorable="d">


    <UserControl.Resources>
        <Style
            x:Key="MeasurementButtonsStyle"
            BasedOn="{StaticResource MaterialDesignFlatDarkBgButton}"
            TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="MaterialDesign:ButtonAssist.CornerRadius" Value="15" />
        </Style>
    </UserControl.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="50*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="60*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button
                        Margin="5"
                        MaterialDesign:ButtonAssist.CornerRadius="15"
                        Command="{Binding DataContext.ZeroCalibrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="{DynamicResource ZeroCalibration}" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <StackPanel
                        Margin="20,0,10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Text="{Binding DeviceConnectionStatusText}" />
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Text="{Binding DeviceCalibrationStatusText}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource MeasurementTimeSec}"
                            Foreground="#E5FFFFFF" />
                        <TextBox
                            x:Name="MeasurementTimeTextBox"
                            MinWidth="40"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            LostFocus="MeasurementTimeTextBox_LostFocus"
                            Text="{Binding MeasurementTime, UpdateSourceTrigger=Explicit}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding DataContext.ApplyMeasurementTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Text, ElementName=MeasurementTimeTextBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <StackPanel Margin="0,5,30,5" Orientation="Horizontal">
                        <Label
                            VerticalAlignment="Center"
                            Content="{DynamicResource SerialNumber}"
                            Foreground="#E5FFFFFF" />
                        <TextBox
                            x:Name="SerialNumberTextBox"
                            MinWidth="180"
                            Margin="5"
                            VerticalAlignment="Center"
                            Foreground="White"
                            LostFocus="SerialNumberTextBox_LostFocus"
                            Text="{Binding SerialNumber, UpdateSourceTrigger=Explicit}">
                            <TextBox.InputBindings>
                                <KeyBinding
                                    Key="Enter"
                                    Command="{Binding DataContext.ApplySerialNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Text, ElementName=SerialNumberTextBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                            <RowDefinition Height="30*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding TopLeftStatus.Location}"
                            Content="{DynamicResource TopLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="TopLeftStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="TopLeftStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding TopCenterStatus.Location}"
                            Content="{DynamicResource TopCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="TopCenterStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="TopCenterStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding TopRightStatus.Location}"
                            Content="{DynamicResource TopRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="TopRightStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="TopRightStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding MiddleLeftStatus.Location}"
                            Content="{DynamicResource MiddleLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="MiddleLeftStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="MiddleLeftStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding CenterStatus.Location}"
                            Content="{DynamicResource CenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="CenterStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="CenterStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding MiddleRightStatus.Location}"
                            Content="{DynamicResource MiddleRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="MiddleRightStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="MiddleRightStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding BottomLeftStatus.Location}"
                            Content="{DynamicResource BottomLeftPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="BottomLeftStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="BottomLeftStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding BottomCenterStatus.Location}"
                            Content="{DynamicResource BottomCenterPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="BottomCenterStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="BottomCenterStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding BottomRightStatus.Location}"
                            Content="{DynamicResource BottomRightPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="BottomRightStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="BottomRightStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                    </Grid>
                    <StackPanel
                        Grid.Row="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding RedColorStatus.Location}"
                            Content="{DynamicResource RedPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="RedColorStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="RedColorStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding GreenColorStatus.Location}"
                            Content="{DynamicResource GreenPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="GreenColorStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="GreenColorStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding BlueColorStatus.Location}"
                            Content="{DynamicResource BluePoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="BlueColorStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="BlueColorStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Command="{Binding DataContext.MeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding BlackColorStatus.Location}"
                            Content="{DynamicResource BlackPoint}"
                            Style="{StaticResource MeasurementButtonsStyle}">
                            <Button.Background>
                                <Binding Path="BlackColorStatus.StatusColor" />
                            </Button.Background>
                            <Button.ToolTip>
                                <Binding Path="BlackColorStatus.MeasuredValuesString" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>



        <TextBox
            x:Name="LogTextBox"
            Grid.Row="1"
            MinHeight="200"
            Margin="0,5,5,5"
            AcceptsReturn="True"
            Background="#FF2A2828"
            BorderBrush="White"
            BorderThickness="1"
            Foreground="White"
            HorizontalScrollBarVisibility="Disabled"
            IsReadOnly="True"
            Text="{Binding LogText, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />


        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Margin="5"
                MaterialDesign:ButtonAssist.CornerRadius="15"
                Command="{Binding DataContext.SaveResultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="{DynamicResource SaveResultsButton}" />
            <Button
                Margin="5"
                MaterialDesign:ButtonAssist.CornerRadius="15"
                Command="{Binding DataContext.ClearFieldsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="{DynamicResource ClearFieldsButton}" />
        </StackPanel>


    </Grid>
</UserControl>