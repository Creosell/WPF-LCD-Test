    <None Remove="Images\WindowsHeaderButtons\close-thick.png" />
    <None Remove="Images\WindowsHeaderButtons\dock-window.png" />
    <None Remove="Images\WindowsHeaderButtons\window-maximize.png" />
    <None Remove="Images\WindowsHeaderButtons\window-minimize.png" />
